{
  "name": "Restaurante - Reserva Automática",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-reserva",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Webhook Reserva",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "webhook-reserva"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/agent/chat",
        "body": {
          "session_id": "={{ $json.body.from }}",
          "message": "={{ $json.body.message }}"
        },
        "options": {}
      },
      "id": "http-1",
      "name": "Ajax - Processa Mensagem",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.response }}",
              "rightValue": "reserva",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-1",
      "name": "É Reserva?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "SUA_PLANILHA_ID",
        "options": {},
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "Timestamp",
              "fieldValue": "={{ $now }}"
            },
            {
              "fieldId": "Cliente",
              "fieldValue": "={{ $json.body.from }}"
            },
            {
              "fieldId": "Mensagem",
              "fieldValue": "={{ $json.body.message }}"
            },
            {
              "fieldId": "Status",
              "fieldValue": "Confirmada"
            }
          ]
        }
      },
      "id": "sheets-1",
      "name": "Salva na Planilha",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [850, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "options": {},
        "responseBody": "={{ JSON.stringify({ message: \"Reserva confirmada! Seu codigo e #RES-\" + Math.floor(Math.random()*9000+1000) }) }}"
      },
      "id": "respond-1",
      "name": "Responde Cliente",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Webhook Reserva": {
      "main": [
        [
          {
            "node": "Ajax - Processa Mensagem",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ajax - Processa Mensagem": {
      "main": [
        [
          {
            "node": "É Reserva?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "É Reserva?": {
      "main": [
        [
          {
            "node": "Salva na Planilha",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Responde Cliente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
